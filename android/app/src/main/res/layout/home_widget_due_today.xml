<?xml version="1.0" encoding="utf-8"?>
<!-- «Para hoy · N tarjetas» (F47, paso 7): el ícono y «Para hoy» arriba, y
     la cifra grande abajo, como las tarjetas de Repasar. Lo llena
     `HomeWidgets.dueTodayViews`. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_background"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/home_widget_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/home_widget_icon_background"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:src="@drawable/ic_home_widget_today" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_widget_due_today_title"
            android:textColor="@color/home_widget_on_surface_variant"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/home_widget_due_today_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/home_widget_primary"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_widget_due_today_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/home_widget_on_surface"
        android:textSize="14sp" />
</LinearLayout>
