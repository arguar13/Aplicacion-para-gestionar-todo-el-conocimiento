<?xml version="1.0" encoding="utf-8"?>
<!-- «Guardar rápido» (F47, paso 7): el portapapeles y lo que hace, en un
     renglón. No cambia nunca: no hay nada que llenar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_widget_background"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/home_widget_padding">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/home_widget_icon_background"
        android:importantForAccessibility="no"
        android:padding="9dp"
        android:src="@drawable/ic_home_widget_paste" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_widget_quick_capture_title"
            android:textColor="@color/home_widget_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/home_widget_quick_capture_hint"
            android:textColor="@color/home_widget_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
