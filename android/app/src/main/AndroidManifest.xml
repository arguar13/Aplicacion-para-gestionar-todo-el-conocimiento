<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Para la tarjeta "Cámara" de la captura (ver `image_picker` en
         pubspec.yaml). `android.hardware.camera` no es obligatorio: hay
         teléfonos Android sin cámara, y el resto de la app funciona igual
         sin una — exigirla dejaría a esos dispositivos afuera de la Play
         Store por completo. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Internet, declarado acá y no de rebote: hasta ahora en las versiones
         publicadas lo traían Sentry y otras bibliotecas, pero el gestor de
         descargas del sistema (F29, ver SystemDownloadsChannel) rechaza el
         pedido de una app sin este permiso, y una dependencia que deje de
         declararlo no puede apagar las descargas de los modelos. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- El trabajo largo —transcribir horas de audio, reconocer las páginas
         de un libro escaneado, bajar un modelo de gigas— en un servicio en
         primer plano con su notificación (F21, decisión C): ver
         `LongWorkService`. `mediaProcessing` para transcribir y reconocer,
         `dataSync` para las descargas y la IA. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- El aviso diario para repasar (F31): al reiniciar el teléfono el sistema
         borra las alarmas, y esto deja volver a programar la de la persona.
         Es un permiso normal: no se le pregunta nada. Ver `StudyReminder`. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Recibir contenido compartido desde otras apps: el botón de
                 compartir del teléfono. `text/plain` para enlaces y texto
                 pegado; `*/*` para cualquier archivo, de a uno o varios a la
                 vez, porque el formato se reconoce mirando los bytes y no el
                 tipo que declare quien comparte (ver FileAdapter). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>
        <service
            android:name=".LongWorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing"/>
        <!-- El aviso diario para repasar (F31): recibe la alarma de la propia
             app (el intent explícito no necesita filtro) y los avisos del
             sistema de que arrancó el teléfono, se actualizó la app o cambió
             la hora o la zona horaria, para volver a programarla. No está
             exportado: solo el sistema y la app le hablan. -->
        <receiver
            android:name=".StudyReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
