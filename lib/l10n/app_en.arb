{
  "@@locale": "en",

  "loginTitle": "Log In",
  "@loginTitle": {
    "description": "Title of the login screen"
  },

  "emailLabel": "Email",
  "@emailLabel": {
    "description": "Label for the email text field"
  },

  "emailEmptyError": "Enter your email.",
  "@emailEmptyError": {
    "description": "Validation error shown when the email field is left empty"
  },

  "emailInvalidError": "Enter a valid email.",
  "@emailInvalidError": {
    "description": "Validation error shown when the email doesn't look like a real address"
  },

  "passwordLabel": "Password",
  "@passwordLabel": {
    "description": "Label for the password text field"
  },

  "passwordEmptyError": "Enter your password.",
  "@passwordEmptyError": {
    "description": "Validation error shown when the password field is left empty"
  },

  "loginButton": "Sign In",
  "@loginButton": {
    "description": "Submit button on the login screen (deliberately distinct wording from loginTitle, both for UX clarity and to keep the title/button uniquely findable in the UI)"
  },

  "passwordsDoNotMatchError": "Passwords don't match.",
  "@passwordsDoNotMatchError": {
    "description": "Shown on sign-up when password and confirmPassword differ"
  },

  "dashboardTitle": "Home",
  "@dashboardTitle": {
    "description": "Title of the dashboard AppBar"
  },

  "lockVaultTooltip": "Lock vault",
  "@lockVaultTooltip": {
    "description": "Tooltip for the button that closes the vault and returns to the unlock screen"
  },

  "emptyLibraryTitle": "Your vault is empty",
  "@emptyLibraryTitle": {
    "description": "Title of the empty state on the home screen, before anything has been captured"
  },

  "emptyLibraryMessage": "Whatever you save here — a video, a thread, an article, a PDF — gets turned into text you can search, without losing where it came from.",
  "@emptyLibraryMessage": {
    "description": "Explanation of the empty state on the home screen"
  },

  "themeModeTooltip": "Change theme",
  "@themeModeTooltip": {
    "description": "Tooltip for the theme (light/dark/system) toggle button"
  },

  "languageTooltip": "Change language",
  "@languageTooltip": {
    "description": "Tooltip for the language toggle button"
  },

  "loadErrorRetry": "Retry",
  "@loadErrorRetry": {
    "description": "Retry button shown when loading the dashboard profile failed"
  },

  "globalErrorValidation": "Please check the information you entered.",
  "@globalErrorValidation": {
    "description": "Shown for a ValidationFailure that reached the UI without a field-level message"
  },

  "globalErrorStorage": "Couldn't read the data stored on this device.",
  "@globalErrorStorage": {
    "description": "Shown for a CacheFailure: local storage could not be read or written"
  },

  "vaultCreateTitle": "Protect your vault",
  "@vaultCreateTitle": {
    "description": "Title of the screen where the user sets up the vault passcode for the first time"
  },

  "vaultCreateSubtitle": "Everything you save stays on this device. Choose a passcode to lock it — there is no way to recover it, so pick something you'll remember.",
  "@vaultCreateSubtitle": {
    "description": "Explanation under the vault creation title"
  },

  "vaultPasscodeLabel": "Passcode",
  "@vaultPasscodeLabel": {
    "description": "Label for the passcode field"
  },

  "vaultConfirmPasscodeLabel": "Repeat passcode",
  "@vaultConfirmPasscodeLabel": {
    "description": "Label for the passcode confirmation field"
  },

  "vaultPasscodeEmptyError": "Enter a passcode.",
  "@vaultPasscodeEmptyError": {
    "description": "Validation error when the passcode field is empty"
  },

  "vaultPasscodeTooShortError": "Use at least {count} characters.",
  "@vaultPasscodeTooShortError": {
    "description": "Validation error when the passcode is shorter than PinPolicy.minLength",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "6"
      }
    }
  },

  "vaultPasscodeMismatchError": "The passcodes don't match.",
  "@vaultPasscodeMismatchError": {
    "description": "Validation error when the two passcode fields differ"
  },

  "vaultCreateAction": "Create vault",
  "@vaultCreateAction": {
    "description": "Submit button on the vault creation screen"
  },

  "vaultUnlockTitle": "Welcome back",
  "@vaultUnlockTitle": {
    "description": "Title of the vault unlock screen"
  },

  "vaultUnlockAction": "Unlock",
  "@vaultUnlockAction": {
    "description": "Submit button on the vault unlock screen"
  },

  "vaultUnlockWrongPasscode": "{count, plural, =1{Wrong passcode. 1 attempt left before a wait.} other{Wrong passcode. {count} attempts left before a wait.}}",
  "@vaultUnlockWrongPasscode": {
    "description": "Shown after a failed unlock attempt, counting down to the lockout",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "vaultUnlockLockedOut": "Too many attempts. Try again in {duration}.",
  "@vaultUnlockLockedOut": {
    "description": "Shown while the vault is temporarily locked after repeated failures",
    "placeholders": {
      "duration": {
        "type": "String",
        "example": "2 minutes"
      }
    }
  },

  "vaultLockedSeconds": "{count, plural, =1{1 second} other{{count} seconds}}",
  "@vaultLockedSeconds": {
    "description": "Duration fragment used inside vaultUnlockLockedOut",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "30"
      }
    }
  },

  "vaultLockedMinutes": "{count, plural, =1{1 minute} other{{count} minutes}}",
  "@vaultLockedMinutes": {
    "description": "Duration fragment used inside vaultUnlockLockedOut",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },

  "vaultLockedHours": "{count, plural, =1{1 hour} other{{count} hours}}",
  "@vaultLockedHours": {
    "description": "Duration fragment used inside vaultUnlockLockedOut",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "1"
      }
    }
  },

  "routeNotFoundTitle": "Page not found",
  "@routeNotFoundTitle": {
    "description": "Title of the screen shown when a URL matches no route (GoRouter errorBuilder)"
  },

  "routeNotFoundMessage": "The address you opened doesn't match any screen in the app. It may be an outdated link.",
  "@routeNotFoundMessage": {
    "description": "Explanation on the route-not-found screen"
  },

  "routeNotFoundAction": "Go to start",
  "@routeNotFoundAction": {
    "description": "Button on the route-not-found screen that returns the user to a valid destination"
  },

  "navHome": "Home",
  "@navHome": {
    "description": "Navigation destination label"
  },

  "navProfile": "Profile",
  "@navProfile": {
    "description": "Navigation destination label"
  },

  "navSettings": "Settings",
  "@navSettings": {
    "description": "Navigation destination label"
  },

  "welcomeMessage": "Welcome back, {name}",
  "@welcomeMessage": {
    "description": "Greeting on the dashboard, includes the signed-in user's name",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ana"
      }
    }
  },

  "resultsCount": "{count, plural, =0{No results} =1{1 result} other{{count} results}}",
  "@resultsCount": {
    "description": "Generic pluralized result-count label, reusable by any future list/search feature",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "globalErrorNetwork": "No internet connection. Please check it and try again.",
  "@globalErrorNetwork": {
    "description": "Global snackbar shown for any failed request caused by a connectivity problem, regardless of the active screen"
  },

  "globalErrorUnauthorized": "Your session expired. Please log in again.",
  "@globalErrorUnauthorized": {
    "description": "Global snackbar shown when a request is rejected for an expired/invalid session"
  },

  "globalErrorServer": "Something went wrong on our end. Please try again shortly.",
  "@globalErrorServer": {
    "description": "Global snackbar shown for an unexpected server-side failure"
  },

  "globalErrorUnexpected": "An unexpected error occurred.",
  "@globalErrorUnexpected": {
    "description": "Global snackbar fallback for any error type not otherwise covered"
  }
}
